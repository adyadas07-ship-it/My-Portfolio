* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Poppins", sans-serif;
    background: #0b1120;
    color: #ffffff;
    line-height: 1.6;
}

/* Navbar */

header {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
    background: rgba(11, 17, 32, 0.9);
    backdrop-filter: blur(10px);
}

.navbar {
    max-width: 1200px;
    margin: auto;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 25px;
    font-weight: 800;
}

.logo span {
    color: #00e5ff;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 30px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-weight: 500;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #00e5ff;
}

.theme-btn {
    border: none;
    background: #172033;
    color: white;
    padding: 10px 14px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 18px;
}


/* Hero */

.hero {
    min-height: 100vh;
    max-width: 1200px;
    margin: auto;
    padding: 150px 20px 80px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
}

.hero-text {
    max-width: 650px;
}

.hello {
    color: #00e5ff;
    font-weight: 600;
    letter-spacing: 3px;
}

.hero h1 {
    font-size: 65px;
    line-height: 1.2;
    margin: 10px 0;
}

.hero h1 span {
    color: #00e5ff;
}

.hero h2 {
    font-size: 30px;
    margin-bottom: 20px;
}

.hero p {
    color: #aab4c8;
    font-size: 17px;
}

.hero-buttons {
    margin-top: 30px;
    display: flex;
    gap: 15px;
}

.btn {
    display: inline-block;
    padding: 13px 25px;
    background: #00e5ff;
    color: #061018;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: 0.3s;
}

.btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0, 229, 255, 0.25);
}

.btn.secondary {
    background: transparent;
    color: #00e5ff;
    border: 1px solid #00e5ff;
}


/* Profile */

.profile-card {
    width: 330px;
    height: 330px;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    background: linear-gradient(135deg, #00e5ff, #7c3aed);

    box-shadow: 0 0 80px rgba(0, 229, 255, 0.2);
}

.profile-circle {
    width: 290px;
    height: 290px;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #101827;

    font-size: 100px;
}


/* Sections */

.section {
    max-width: 1200px;
    margin: auto;
    padding: 100px 20px;
}

.section-title {
    text-align: center;
    font-size: 40px;
    margin-bottom: 60px;
}

.section-title span {
    color: #00e5ff;
}


/* About */

.about-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
}

.about-image {
    height: 350px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #111a2c;
    border-radius: 20px;
}

.about-icon {
    font-size: 120px;
}

.about-text h3 {
    font-size: 30px;
    margin-bottom: 20px;
}

.about-text p {
    color: #aab4c8;
    margin-bottom: 15px;
}

.info {
    margin: 20px 0;
}


/* Skills */

.skills-section {
    background: #0f172a;
    max-width: 100%;
    padding-left: calc((100% - 1160px) / 2);
    padding-right: calc((100% - 1160px) / 2);
}

.skills-container {
    max-width: 800px;
    margin: auto;
}

.skill {
    margin-bottom: 25px;
}

.skill-title {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
}

.progress {
    height: 10px;
    background: #202b3f;
    border-radius: 20px;
    overflow: hidden;
}

.progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #00e5ff, #7c3aed);
    border-radius: 20px;
}

.html {
    width: 90%;
}

.css {
    width: 85%;
}

.js {
    width: 75%;
}

.python {
    width: 80%;
}


/* Projects */

.projects-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.project-card {
    background: #111a2c;
    padding: 30px;
    border-radius: 15px;
    border: 1px solid #1e2b40;
    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-8px);
    border-color: #00e5ff;
}

.project-icon {
    font-size: 50px;
    margin-bottom: 15px;
}

.project-card h3 {
    font-size: 23px;
    margin-bottom: 10px;
}

.project-card p {
    color: #aab4c8;
}

.tags {
    margin: 20px 0;
}

.tags span {
    display: inline-block;
    background: #1b2940;
    color: #00e5ff;
    padding: 5px 10px;
    margin: 3px;
    border-radius: 5px;
    font-size: 12px;
}

.project-btn {
    color: #00e5ff;
    text-decoration: none;
    font-weight: 600;
}


/* Contact */

.contact-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
}

.contact-info h3 {
    font-size: 30px;
    margin-bottom: 20px;
}

.contact-info p {
    color: #aab4c8;
    margin: 15px 0;
}

form {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

input,
textarea {
    width: 100%;
    padding: 15px;
    border: 1px solid #26344b;
    background: #111a2c;
    color: white;
    border-radius: 8px;
    outline: none;
    font-family: inherit;
}

input:focus,
textarea:focus {
    border-color: #00e5ff;
}


/* Footer */

footer {
    padding: 30px 20px;
    text-align: center;
    background: #080d18;
    color: #8f9bb0;
}

.social-links {
    margin-top: 10px;
}

.social-links a {
    color: #00e5ff;
    text-decoration: none;
    margin: 0 10px;
}


/* Light Theme */

body.light {
    background: #f5f7fb;
    color: #111827;
}

body.light header {
    background: rgba(255, 255, 255, 0.9);
}

body.light .nav-links a {
    color: #111827;
}

body.light .hero p,
body.light .about-text p,
body.light .project-card p,
body.light .contact-info p {
    color: #5b6472;
}

body.light .project-card,
body.light .about-image,
body.light input,
body.light textarea {
    background: white;
}

body.light .skills-section {
    background: #e9eef7;
}

body.light .profile-circle {
    background: white;
}


/* Responsive */

@media (max-width: 900px) {

    .nav-links {
        display: none;
    }

    .hero {
        flex-direction: column;
        text-align: center;
        padding-top: 140px;
    }

    .hero-buttons {
        justify-content: center;
    }

    .about-container,
    .contact-container {
        grid-template-columns: 1fr;
    }

    .projects-container {
        grid-template-columns: 1fr 1fr;
    }

}


@media (max-width: 600px) {

    .hero h1 {
        font-size: 45px;
    }

    .hero h2 {
        font-size: 22px;
    }

    .profile-card {
        width: 250px;
        height: 250px;
    }

    .profile-circle {
        width: 220px;
        height: 220px;
        font-size: 70px;
    }

    .projects-container {
        grid-template-columns: 1fr;
    }

    .section-title {
        font-size: 32px;
    }

}